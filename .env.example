# Copy this file to `.env` and fill in the values you want.
# Never commit the populated `.env` file.

# Optional. Visitors can supply their own key in the UI. When this server
# key is set, it is used for scans started without a visitor key. With no
# key at all, scans run on Modrinth data alone and unsettled mods are
# reported as UNKNOWN.
OPENAI_API_KEY=
# AdSense auto ads (optional; leave blank to disable)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_TEST_MODE=on
